NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8090

# Вставте сюди ваш DATABASE_URL (з Neon у хмарі або локального PostgreSQL):
DATABASE_URL=postgresql://smartgarden:smartgarden@localhost:5432/smartgarden?schema=public

# Для локальної роботи без Redis залиште memory; для продакшену вкажіть Upstash URL:
REDIS_URL=memory

# Секрети (у продакшені обов'язково згенеруйте нові >= 32 символів)
ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me-32chars-min
REFRESH_TOKEN_SECRET=dev-refresh-token-secret-change-me-32chars
COOKIE_SECRET=dev-cookie-secret-change-me-32-characters!
CSRF_SECRET=dev-csrf-secret-change-me-32-characters!!

# Пошта та S3 (заглушки для локального старту без Docker; для фото в хмарі замініть на R2/Supabase)
EMAIL_FROM="Smart Garden <noreply@smartgarden.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=smart-garden
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=http://localhost:9000

SWAGGER_ENABLED=true

