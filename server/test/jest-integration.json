{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "CommonJS",
          "esModuleInterop": true
        }
      }
    ]
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.ts"]
}
